<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.RoboticsScoutingMatchApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/aztech_blue</item>
        <item name="colorPrimaryVariant">@color/aztech_blue_accent</item>
        <item name="colorOnPrimary">@color/aztech_yellow</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/aztech_yellow</item>
        <item name="colorSecondaryVariant">@color/aztech_yellow_accent</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Customize your theme here. -->
        <item name="android:windowBackground">@color/aztech_blue_accent</item>
        <item name="colorSurface">@color/aztech_blue_accent</item>
        <item name="android:colorBackground">@color/aztech_blue_accent</item>
    </style>
</resources>
